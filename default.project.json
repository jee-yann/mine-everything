{
  "name": "EndlessMining",
  "globIgnorePaths": ["**/MineOrigins"],
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedFirst": {
      "$ignoreUnknownInstances": true,
      "MiningLoading": {
        "$path": "src/first/MiningLoading.client.luau"
      }
    },
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$ignoreUnknownInstances": true,
        "$path": "src/shared",
        "TideCoast": {
          "$path": "map/TideCoast.rbxm"
        }
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "Server": {
        "$ignoreUnknownInstances": true,
        "$path": "src/server"
      }
    },
    "StarterGui": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "LoadCharacterAppearance": true,
        "CameraMaxZoomDistance": 28
      },
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "Client": {
          "$ignoreUnknownInstances": true,
          "$path": "src/client",
          "CinematicActors": {
            "$className": "Folder",
            "RobloxRig": {
              "$path": "src/client/MineOrigins/RobloxRig.luau"
            },
            "Props": {
              "$path": "src/client/MineOrigins/Props.luau"
            }
          }
        }
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 384,
        "FallenPartsDestroyHeight": -50000
      },
      "CitrineCove": {
        "$path": "map/CitrineCove.rbxmx",
        "Offshore water": {
          "$path": "map/OffshoreWater.rbxm"
        }
      },
      "Camera": {
        "$className": "Camera",
        "$properties": {
          "CFrame": [
            32,
            94,
            166,
            0.9777063,
            -0.0666367,
            0.199123,
            0.0,
            0.9483077,
            0.3173523,
            -0.2099772,
            -0.3102773,
            0.9271664
          ],
          "Focus": [
            0,
            43,
            17,
            1,
            0,
            0,
            0,
            1,
            0,
            0,
            0,
            1
          ],
          "FieldOfView": 65
        }
      }
    },
    "Lighting": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "Ambient": [
          0.24,
          0.22,
          0.28
        ],
        "Brightness": 1.9,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "ShadowMap",
        "ClockTime": 15.2,
        "OutdoorAmbient": [
          0.49,
          0.5,
          0.56
        ],
        "GeographicLatitude": 50,
        "ExposureCompensation": -0.24
      },
      "SeaAir": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.21,
          "Offset": 0.16,
          "Color": [
            0.79,
            0.91,
            1
          ],
          "Decay": [
            0.63,
            0.79,
            0.91
          ],
          "Glare": 0.03,
          "Haze": 0.4
        }
      },
      "MarketGlow": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.14,
          "Size": 12,
          "Threshold": 1.45
        }
      }
    },
    "SoundService": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
